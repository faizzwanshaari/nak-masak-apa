<!doctype html>
<html lang="ms">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Nak Masak Apa? 🐱</title>
<meta name="theme-color" content="#ffb3c6">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="icon.svg">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fff4f7; --card:#ffffff; --ink:#2b2730; --muted:#8a8294;
  --pink:#ff8fab; --pink-soft:#ffd6e2; --mint:#b8f2e6; --yellow:#ffe066;
  --line:#2b2730;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{
  font-family:'Baloo 2',system-ui,sans-serif;color:var(--ink);background:var(--bg);
  background-image:radial-gradient(var(--pink-soft) 2px,transparent 2px);background-size:26px 26px;
  padding-bottom:calc(84px + env(safe-area-inset-bottom));
}
#app{max-width:480px;margin:0 auto;padding:16px 16px 0}
h1{font-size:28px;font-weight:800;margin:6px 0 2px;line-height:1.1}
h2{font-size:22px;font-weight:800;margin:4px 0 12px}
p{margin:0}
.sub{color:var(--muted);font-size:16px;margin-bottom:14px}

/* Cute cards with chunky outline */
.card{
  background:var(--card);border:3px solid var(--line);border-radius:22px;
  box-shadow:0 5px 0 var(--line);padding:14px;margin-bottom:14px;
}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  font:inherit;font-weight:800;font-size:18px;color:var(--ink);
  background:var(--pink);border:3px solid var(--line);border-radius:999px;
  box-shadow:0 5px 0 var(--line);padding:12px 22px;cursor:pointer;
  transition:transform .08s,box-shadow .08s;width:100%;
}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--line)}
.btn.alt{background:var(--mint)}
.btn.yellow{background:var(--yellow)}
.btn.ghost{background:#fff;width:auto}
.btn.small{font-size:15px;padding:8px 14px;width:auto}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tile{
  background:var(--card);border:3px solid var(--line);border-radius:22px;box-shadow:0 5px 0 var(--line);
  padding:16px 8px;text-align:center;font:inherit;font-weight:800;font-size:17px;color:var(--ink);cursor:pointer;
  transition:transform .08s,box-shadow .08s;
}
.tile .e{display:block;font-size:40px;margin-bottom:4px}
.tile:active{transform:translateY(4px);box-shadow:0 1px 0 var(--line)}
.tile.sel{background:var(--mint)}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{
  font:inherit;font-weight:700;font-size:16px;color:var(--ink);background:#fff;
  border:3px solid var(--line);border-radius:999px;padding:8px 16px;cursor:pointer;
}
.chip.sel{background:var(--pink)}
.crumbs{display:flex;gap:6px;margin-bottom:12px;font-size:14px;color:var(--muted)}
.crumbs span.on{color:var(--ink);font-weight:800}

.row{display:flex;align-items:center;gap:12px}
.row .grow{flex:1;min-width:0}
.dish-name{font-weight:800;font-size:18px}
.meta{font-size:14px;color:var(--muted)}
.heart{font:inherit;font-size:26px;background:none;border:0;cursor:pointer;padding:4px}

.yoshi{display:block;margin:0 auto;animation:bob 2.6s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.hero{text-align:center;padding:6px 0 2px}
.bubble{
  display:inline-block;background:#fff;border:3px solid var(--line);border-radius:18px;
  padding:8px 14px;font-weight:700;margin-top:6px;position:relative;
}

.empty{text-align:center;padding:24px 12px;color:var(--muted)}
.empty .yoshi{margin-bottom:10px}

/* Spin overlay */
.overlay{position:fixed;inset:0;background:rgba(43,39,48,.55);display:flex;align-items:center;justify-content:center;padding:20px;z-index:50}
.overlay .card{width:100%;max-width:340px;text-align:center}
.spin-name{font-size:26px;font-weight:800;min-height:40px;margin:8px 0}
.spin-emoji{font-size:64px;line-height:1.1}
.pop{animation:pop .35s ease-out}
@keyframes pop{0%{transform:scale(.7);opacity:0}100%{transform:scale(1);opacity:1}}

/* Ingredient rows */
.ing{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:2px dashed var(--pink-soft);font-size:17px}
.ing:last-child{border-bottom:0}
.ing input{width:22px;height:22px;accent-color:var(--pink)}
.steps{line-height:1.5;font-size:17px}

/* Bottom nav */
.nav{
  position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:3px solid var(--line);
  display:flex;justify-content:space-around;padding:8px 8px calc(8px + env(safe-area-inset-bottom));z-index:40;
  max-width:480px;margin:0 auto;border-radius:22px 22px 0 0;
}
.nav button{
  flex:1;font:inherit;font-weight:800;font-size:14px;background:none;border:0;color:var(--muted);cursor:pointer;padding:6px 0;
  display:flex;flex-direction:column;align-items:center;gap:2px;border-radius:16px;
}
.nav button .i{font-size:24px}
.nav button.on{color:var(--ink);background:var(--pink-soft)}

.toast{position:fixed;left:50%;bottom:110px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-weight:700;z-index:60;opacity:0;transition:opacity .2s;pointer-events:none}
.toast.show{opacity:1}
.tiny{font-size:13px;color:var(--muted);text-align:center;margin-top:10px}
</style>
</head>
