      </div>
      <div style="margin-top:16px"><button class="btn" data-act="go-results">Tunjuk menu 😸</button></div>
      <div style="margin-top:10px"><button class="btn ghost" data-act="back">‹ Kembali</button></div>`;
    return;
  }
  if(S.screen==='results'){
    const list=filtered();
    $app.innerHTML=`${crumbs(3)}<h2>Pilihan kau (${list.length})</h2>
      ${list.length?`<div class="card"><button class="btn yellow" data-act="spin">🎰 Pilihkan untuk saya</button></div>`:''}
      ${list.length?list.map(d=>dishRow(d)).join(''):`<div class="card empty">${yoshi(100)}<p style="margin-top:8px">Tak jumpa menu yang sama. Cuba tukar pilihan.</p></div>`}
      <div style="margin-top:6px"><button class="btn ghost" data-act="restart">🔄 Mula semula</button></div>`;
    return;
  }
  if(S.screen==='detail'){
    const d=dishById(S.openId);
    if(!d){S.screen='home';return render()}
    const isFav=favs.includes(d.id);
    $app.innerHTML=`
      <div class="card" style="text-align:center">
        <div style="font-size:72px;line-height:1.1">${d.e}</div>
        <h2 style="margin:6px 0">${d.n}</h2>
        <p class="meta">${d.s} · ${d.m} min · ${PROTEIN.find(p=>p.k===d.p).label}</p>
        <div style="margin-top:10px" class="chips" >
          <button class="chip ${isFav?'sel':''}" data-act="fav" data-v="${d.id}">${isFav?'💖 Kegemaran':'🤍 Tambah kegemaran'}</button>
        </div>
      </div>
      <div class="card">
        <h2 style="font-size:19px">Bahan 🥕</h2>
        ${d.ing.map(i=>`<div class="ing"><span>•</span>${i}</div>`).join('')}
        <div style="margin-top:12px"><button class="btn alt small" data-act="add-shop" data-v="${d.id}">+ Masuk senarai beli 🛒</button></div>
      </div>
      <div class="card">
        <h2 style="font-size:19px">Cara masak 🍳</h2>
        <p class="steps">${d.st}</p>
      </div>
      <div><button class="btn ghost" data-act="back-results">‹ Kembali ke pilihan</button></div>`;
    return;
  }
}
function dishRow(d){
  const isFav=favs.includes(d.id);
  return `<div class="card row" style="padding:12px">
    <button class="tile" style="width:64px;padding:8px;box-shadow:none;border-width:2px" data-act="open" data-v="${d.id}"><span class="e" style="font-size:30px;margin:0">${d.e}</span></button>
    <div class="grow" data-act="open" data-v="${d.id}" style="cursor:pointer">
      <div class="dish-name">${d.n}</div>
      <div class="meta">${d.s} · ${d.m} min</div>
    </div>
    <button class="heart" data-act="fav" data-v="${d.id}" aria-label="Kegemaran">${isFav?'💖':'🤍'}</button>
  </div>`;
}

function renderFavs(){
  const list=favs.map(dishById).filter(Boolean);
  $app.innerHTML=`<h1>Kegemaran 💖</h1><p class="sub">Menu yang kau suka</p>
    ${list.length?list.map(d=>dishRow(d)).join(''):`<div class="card empty">${yoshi(100)}<p style="margin-top:8px">Belum ada kegemaran. Tekan 🤍 pada menu.</p></div>`}`;
}

function renderShop(){
  const done=shop.filter(x=>x.done).length;
  $app.innerHTML=`<h1>Senarai Beli 🛒</h1>
    <p class="sub">${shop.length?`${done}/${shop.length} dah ambil`:'Kosong lagi'}</p>
    ${shop.length?`<div class="card">${shop.map((x,i)=>`
      <div class="ing">
        <input type="checkbox" data-act="tick" data-v="${i}" ${x.done?'checked':''}>
        <span style="flex:1;${x.done?'text-decoration:line-through;color:var(--muted)':''}">${x.t}</span>
        <button class="heart" style="font-size:18px" data-act="del" data-v="${i}" aria-label="Buang">✖️</button>
      </div>`).join('')}</div>
      <button class="btn ghost" data-act="clear-shop">🧹 Kosongkan senarai</button>`
      :`<div class="card empty">${yoshi(100)}<p style="margin-top:8px">Tambah bahan dari resipi.</p></div>`}`;
}

/* ---------- ACTIONS ---------- */
function spin(){
  const list=filtered();
  if(!list.length||S.spinning)return;
  S.spinning=true;
  const ov=document.createElement('div');
  ov.className='overlay';
  ov.innerHTML=`<div class="card pop"><div class="spin-emoji" id="se">🎲</div><div class="spin-name" id="sn">...</div></div>`;
  document.body.appendChild(ov);
  const pick=list[Math.floor(Math.random()*list.length)];
  let ticks=0;const total=18;
  const timer=setInterval(()=>{
    const r=list[Math.floor(Math.random()*list.length)];
    document.getElementById('se').textContent=r.e;
    document.getElementById('sn').textContent=r.n;
    ticks++;
    if(ticks>=total){
      clearInterval(timer);
      document.getElementById('se').textContent=pick.e;
      document.getElementById('sn').textContent=pick.n;
      ov.querySelector('.card').insertAdjacentHTML('beforeend',`
        <div style="display:grid;gap:10px;margin-top:14px">
          <button class="btn" data-act="spin-open" data-v="${pick.id}">Tengok resipi 😸</button>
          <button class="btn ghost" data-act="spin-close">Tutup</button>
        </div>`);
      S.spinning=false;
    }
  },90);
  ov.addEventListener('click',e=>{
    const b=e.target.closest('[data-act]');
    if(!b)return;
    if(b.dataset.act==='spin-open'){S.openId=b.dataset.v;S.screen='detail';ov.remove();render();window.scrollTo(0,0)}
    if(b.dataset.act==='spin-close'){ov.remove()}
  });
  ov._timer=timer;
}

function handle(act,v,el){
  switch(act){
    case 'start': S.screen='protein'; break;
    case 'pick-p': S.p=v; S.screen='style'; break;
    case 'any-p': S.p=null; S.screen='style'; break;
    case 'pick-s': S.s=v||null; render(); return;
    case 'go-time':
      if(S.s && countFor(S.p,S.s,null)===0) S.s=null;
      S.screen='time'; break;
    case 'pick-t': S.t=v||null; render(); return;
    case 'go-results':
      if(S.t && countFor(S.p,S.s,S.t)===0) S.t=null;
      S.screen='results'; break;
    case 'back':
      S.screen = S.screen==='time'?'style':S.screen==='style'?'protein':'home';
      break;
    case 'restart': S.p=S.s=S.t=null; S.screen='protein'; break;
    case 'spin': spin(); return;
    case 'open': S.openId=v; S.screen='detail'; window.scrollTo(0,0); break;
    case 'back-results': S.screen='results'; break;
    case 'fav':
      favs = favs.includes(v) ? favs.filter(x=>x!==v) : [...favs,v];
      saveFavs(); toast(favs.includes(v)?'Ditambah ke kegemaran 💖':'Dibuang dari kegemaran');
      break;
    case 'add-shop': {
      const d=dishById(v);
      let added=0;
      d.ing.forEach(i=>{ if(!shop.some(x=>x.t===i)){shop.push({t:i,done:false});added++} });
      saveShop(); toast(added?`+${added} bahan masuk senarai 🛒`:'Semua bahan dah ada 🛒');
      break;
    }
    case 'tick': shop[+v].done=!shop[+v].done; saveShop(); return;
    case 'del': shop.splice(+v,1); saveShop(); break;
    case 'clear-shop': if(confirm('Kosongkan senarai beli?')){shop=[];saveShop()} break;
  }
  render();
}

/* ---------- EVENTS ---------- */
document.addEventListener('click',e=>{
  const nav=e.target.closest('#nav button');
  if(nav){
    S.tab=nav.dataset.tab;
    if(S.tab==='pilih' && S.screen==='detail') S.screen='results';
    window.scrollTo(0,0);render();return;
  }
  const el=e.target.closest('[data-act]');
  if(!el)return;
  if(el.dataset.act==='fav' && S.screen!=='detail' && S.tab!=='pilih'){ /* fall through */ }
  const act=el.dataset.act;
  if(act==='tick')return;
  e.stopPropagation();
  handle(act,el.dataset.v,el);
});
document.addEventListener('change',e=>{
  const el=e.target.closest('[data-act="tick"]');
  if(el){handle('tick',el.dataset.v,el)}
});

/* ---------- START ---------- */
render();
if('serviceWorker' in navigator && (location.protocol==='https:'||location.hostname==='localhost')){
  navigator.serviceWorker.register('sw.js').catch(()=>{});
}
</script>
</body>
</html>
