/* ---------- STATE ---------- */
const S={tab:'pilih',screen:'protein',p:null,s:null,t:null,openId:null,spinning:false};
const $app=document.getElementById('app');

function toast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove('show'),1600);
}
function saveFavs(){store.set('favs',favs)}
function saveShop(){store.set('shop',shop)}

function filtered(){
  return MENU.filter(d=>
    (S.p?d.p===S.p:ALLOWED.includes(d.p))&&
    (!S.s||d.s===S.s)&&
    (!S.t||TIME.find(x=>x.k===S.t).test(d.m))
  );
}

function countFor(p,s,t){
  return MENU.filter(d=>
    (p?d.p===p:ALLOWED.includes(d.p))&&(!s||d.s===s)&&(!t||TIME.find(x=>x.k===t).test(d.m))
  ).length;
}

/* ---------- RENDER ---------- */
function render(){
  document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('on',b.dataset.tab===S.tab));
  if(S.tab==='pilih') renderPilih();
  else if(S.tab==='kegemaran') renderFavs();
  else renderShop();
}

function crumbs(step){
  const labels=['Bahan','Gaya','Masa','Menu'];
  return `<div class="crumbs">${labels.map((l,i)=>`<span class="${i===step?'on':''}">${i+1}. ${l}</span>`).join(' › ')}</div>`;
}

